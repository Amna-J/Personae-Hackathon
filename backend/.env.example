# Personae backend environment — copy to .env and fill in real values.
# .env is gitignored; never commit real secrets.

# Groq API key — vision LLM (moodboard decomposition, profile) + item judge.
GROQ_API_KEY=

# YouCam s2s API key — virtual try-on (cloth/shoes/bag) + skin-tone cross-check.
YOUCAM_API_KEY=
# Optional: override the default base URL.
YOUCAM_BASE_URL=https://yce-api-01.makeupar.com

# DB engine: "postgres" uses Postgres, anything else/unset uses local SQLite.
DB_ENGINE=sqlite
# Postgres-only (used when DB_ENGINE=postgres):
# DB_NAME=personaedb
# DB_USER=postgres
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# Style-check pipeline timeout in seconds (endpoint returns 504 on timeout).
# STYLE_CHECK_TIMEOUT_SECONDS=360

# Set to 0 to disable the YouCam color-tone cross-check on skin-tone analysis.
# YOUCAM_COLOR_TONE_CROSSCHECK=1
